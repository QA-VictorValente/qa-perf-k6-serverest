{
  "name": "04-perf-k6",
  "version": "1.0.0",
  "description": "Performance & Load Testing with Grafana k6 against ServeRest API",
  "main": "index.js",
  "scripts": {
    "test": "k6 run src/scenarios/smoke-test.js",
    "test:smoke": "k6 run src/scenarios/smoke-test.js",
    "test:load": "k6 run src/scenarios/load-test.js",
    "test:stress": "k6 run src/scenarios/stress-test.js",
    "serverest": "serverest -p 3001 --nodoc",
    "test:smoke:local": "k6 run -e BASE_URL=http://localhost:3001 src/scenarios/smoke-test.js",
    "test:load:local": "k6 run -e BASE_URL=http://localhost:3001 src/scenarios/load-test.js",
    "test:stress:local": "k6 run -e BASE_URL=http://localhost:3001 src/scenarios/stress-test.js"
  },
  "keywords": [
    "k6",
    "grafana-k6",
    "performance-testing",
    "load-testing",
    "stress-testing",
    "serverest",
    "sdet",
    "qa"
  ],
  "author": "Victor",
  "license": "MIT",
  "devDependencies": {
    "serverest": "^2.29.7"
  }
}
